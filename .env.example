# Copie para .env e substitua todos os valores CHANGE_ME. Nunca envie .env ao Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/home_davi
DATABASE_USERNAME=home_davi
DATABASE_PASSWORD=CHANGE_ME

PLUGGY_WEBHOOK_SECRET=CHANGE_ME
PLUGGY_CLIENT_ID=CHANGE_ME
PLUGGY_CLIENT_SECRET=CHANGE_ME
PLUGGY_API_URL=https://api.pluggy.ai

# Obrigatório para autenticar clientes no endpoint MCP (/mcp).
# Gere um valor forte com: openssl rand -hex 32
# Configure MCP_AUTH_TOKEN no .env do servidor e no cliente MCP; não versione o valor.
# MCP_AUTH_TOKEN=

# Entrega opcional de resumos financeiros ao Hermes.
HERMES_WEBHOOK_ENABLED=false
HERMES_WEBHOOK_URL=http://192.168.2.127:8644/webhooks/home-davi-finance
HERMES_WEBHOOK_SECRET=CHANGE_ME
