# Build context: raiz do projeto. Exemplo:
# docker build -f src/main/docker/Dockerfile.jvm -t home-davi:local .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -q dependency:go-offline

COPY src src
RUN ./mvnw -q package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app

RUN addgroup --system home-davi && adduser --system --ingroup home-davi home-davi
COPY --from=build /workspace/target/home-davi-*.jar /app/home-davi.jar

USER home-davi
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/home-davi.jar"]
